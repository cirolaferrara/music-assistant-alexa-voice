# Music Assistant API (Home Assistant add-on default internal port is 8095)
MA_URL=http://host.docker.internal:8095
MA_TOKEN=replace-with-your-ma-api-token

# Default player queue ID from Music Assistant (Settings -> Players -> copy player ID)
# Example from your setup: your Sat1 player ID
DEFAULT_PLAYER_ID=replace-with-player-id

# Optional friendly-name aliases mapped to MA player IDs
# PLAYER_ALIASES={"kitchen":"abc123","office":"def456","satellite":"ghi789"}

# Alexa request signature verification (disable only for local simulator testing)
SKILL_VERIFY_REQUESTS=true

PORT=5000
